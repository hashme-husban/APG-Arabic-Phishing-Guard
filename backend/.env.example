# APG Backend production environment example
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRE_MINUTES=1440

# PostgreSQL example for production
DATABASE_URL=postgresql+psycopg2://apg_user:change-me@db:5432/apg
# SQLite local development fallback:
# DATABASE_URL=sqlite:///./apg_admin.db

CORS_ALLOWED_ORIGINS=https://admin.example.com,https://api.example.com
API_BASE_URL=https://api.example.com/api
FRONTEND_URL=https://admin.example.com

ADMIN_EMAIL=admin@example.com
# Set only for explicit seed/create-admin commands. Do not commit real passwords.
ADMIN_PASSWORD=change-me-before-deploy
ENABLE_DEMO_DATA=false
ENABLE_DEV_SEED_ON_STARTUP=false

# Gmail SMTP email verification
# Use a Gmail App Password, not your normal Gmail account password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=true
EMAIL_FROM=APG <your-gmail@gmail.com>

EXPORT_DIR=/app/exports
PDF_EXPORT_DIR=/app/exports/pdf
MODEL_VERSION=APG-NLP v1.9
RULES_VERSION=rules-2026.05

# ── Risk Intelligence Engine v1 ────────────────────────────────────────────────
# risk_engine_v1 (default, recommended) | v5 (legacy fallback)
APG_ANALYZER_ENGINE=risk_engine_v1

# URL reputation providers — missing key = provider skipped (not an error)
URL_REPUTATION_ENABLED=true
URL_REPUTATION_TIMEOUT_SECONDS=3
URL_REPUTATION_CACHE_TTL_HOURS=12
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
PHISHTANK_API_KEY=

# ── Dynamic URL Analysis sandbox (Phase 5A: VPS-ready, disabled by default) ──
# When true the engine opens URLs in an isolated headless Chromium browser and
# logs observations to the admin explain endpoint (shadow mode — no score impact).
#
# Requirements before enabling:
#   1. Build the backend Docker image with Playwright Chromium installed.
#   2. Review docs/PHASE2_DYNAMIC_URL_ANALYSIS_PLAN.md — security requirements.
#   3. Run only behind a firewall; ensure outbound HTTP/HTTPS is allowed.
#
# Timeout is clamped to 1–20 seconds regardless of this value.
# Default: false — backend starts and operates normally without Playwright.
DYNAMIC_URL_ANALYSIS_ENABLED=false
DYNAMIC_URL_ANALYSIS_TIMEOUT_SECONDS=8
DYNAMIC_URL_ANALYSIS_OBSERVATION_MS=1500
DYNAMIC_URL_ANALYSIS_TIME_SIMULATION_ENABLED=false
DYNAMIC_URL_ANALYSIS_SIMULATED_MINUTES=0

# ── Passive Threat Intelligence Memory ───────────────────────────────────────
# Cleanup is never automatic unless explicitly enabled and called by admin tools.
INTELLIGENCE_MEMORY_RETENTION_DAYS=90
INTELLIGENCE_MEMORY_CLEANUP_ENABLED=false

# ── Backend Arabic OCR ────────────────────────────────────────────────────────
# Requires tesseract-ocr + tesseract-ocr-ara installed in Docker (already in image).
# Disable to reject OCR requests with 503 (QR extraction still works locally).
OCR_ENABLED=true
# OCR_ENGINE: auto | paddle | paddle_microservice | tesseract
#   auto              — tries PaddleOCR microservice first (if URL set), then Tesseract
#   paddle / paddle_microservice — PaddleOCR microservice only (error if URL not set)
#   tesseract         — Tesseract only (no microservice needed)
# NOTE: PaddleOCR runs in its own ocr_service container (numpy==1.26.4) to avoid
# conflicting with the main ML stack (numpy==2.2.1 for scikit-learn/torch/transformers).
OCR_ENGINE=auto
OCR_MAX_IMAGE_MB=5
OCR_LANGUAGES=ara+eng
# Internal Docker URL for the PaddleOCR microservice.
# Set by docker-compose.yml automatically; override only if running outside compose.
# Leave empty to disable PaddleOCR microservice and use Tesseract only.
OCR_PADDLE_SERVICE_URL=http://ocr_service:9000/ocr
OCR_PADDLE_TIMEOUT_SECONDS=20
