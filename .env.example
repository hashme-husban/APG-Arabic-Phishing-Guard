# APG — Arabic Phishing Guard
# Root environment example for Docker Compose deployment.
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.

APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_SECRET=replace-with-a-long-random-app-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRE_MINUTES=1440

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_DB=apg
POSTGRES_USER=apg_user
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg2://apg_user:change-this-postgres-password@db:5432/apg

# ── Public URLs ─────────────────────────────────────────────────────────────────
# Replace with your domain after DNS/HTTPS is configured.
HTTP_PORT=80
CORS_ALLOWED_ORIGINS=https://your-domain.com
API_BASE_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com

# ── Admin bootstrap ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy

# ── Frontend build-time config ───────────────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_APP_NAME=APG Admin Console
VITE_ENABLE_DEMO_MODE=false

# ── Runtime options ──────────────────────────────────────────────────────────────
ENABLE_DEMO_DATA=false
ENABLE_DEV_SEED_ON_STARTUP=false
EXPORT_DIR=/app/exports
PDF_EXPORT_DIR=/app/exports/pdf
MODEL_VERSION=APG-NLP v1.9
RULES_VERSION=rules-2026.05

# ── Risk Intelligence Engine ─────────────────────────────────────────────────────
APG_ANALYZER_ENGINE=risk_engine_v1

# ── URL Reputation providers ─────────────────────────────────────────────────────
# Missing key = provider skipped (not an error).
URL_REPUTATION_ENABLED=true
URL_REPUTATION_TIMEOUT_SECONDS=3
URL_REPUTATION_CACHE_TTL_HOURS=12
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key-here
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
URLSCAN_API_KEY=your-urlscan-api-key-here
PHISHTANK_API_KEY=your-phishtank-api-key-here
